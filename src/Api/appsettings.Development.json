{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=TodoDb;Username=postgres;Password=postgres"
  },

  "Jwt": {
    "Issuer": "Todo.Api",
    "Audience": "Todo.Api.Client",
    "SecretKey": "CHANGE-ME-TO-A-LONG-RANDOM-SECRET-AT-LEAST-32-CHARACTERS",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "*"
}
